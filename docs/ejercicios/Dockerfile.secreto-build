# syntax=docker/dockerfile:1
# Demostración del Ejercicio 6, Paso 4: secretos en tiempo de construcción con BuildKit.
# El token se monta como archivo SOLO durante el RUN que lo pide; no queda en ninguna capa,
# ni en `docker history`, ni en los metadatos (a diferencia de ARG o ENV).
#
#   docker build --secret id=pip_token,src=<archivo> -f docs/ejercicios/Dockerfile.secreto-build -t demo-secreto docs/ejercicios
FROM alpine:3.24
RUN --mount=type=secret,id=pip_token,required=true \
    echo "token disponible en este RUN: $(wc -c < /run/secrets/pip_token) bytes"
RUN if [ -e /run/secrets/pip_token ]; then echo "FUGA: el token sigue montado"; exit 1; \
    else echo "en el siguiente RUN el token ya no existe"; fi
