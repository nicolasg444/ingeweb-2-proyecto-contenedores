# Copiar a .env (scripts/generar-secretos.sh lo hace). Este archivo SÍ se versiona.
# Aquí no van contraseñas: viven en secrets/*.txt y llegan como secretos de Compose.
DB_NAME=mercado
# Superusuario de PostgreSQL (solo administración)
DB_ADMIN_USER=mercado_admin
# Rol de la aplicación con permisos mínimos (lo crea db/init/02_rol_app.sh)
DB_USER=mercado_app
# Segundos que el catálogo vive en Redis
CACHE_TTL_SECONDS=60
# Puerto del anfitrión donde se publica Nginx
WEB_PORT=8080
